"""Construct a supplied genesis candidate offline; no parameters are approved by this tool."""
import argparse
import hashlib
import json
import struct
import sys


def double_sha(data):
    return hashlib.sha256(hashlib.sha256(data).digest()).digest()


def compact_target(bits):
    size, word = bits >> 24, bits & 0x7fffff
    if word == 0 or bits & 0x800000:
        raise ValueError('invalid compact target')
    target = word >> (8 * (3 - size)) if size <= 3 else word << (8 * (size - 3))
    if not 0 < target < (1 << 256):
        raise ValueError('compact target out of range')
    return target


def candidate(message, block_time, bits, first, last):
    msg = message.encode('utf-8')
    if not 1 <= len(msg) <= 75:
        raise ValueError('message must be 1–75 UTF-8 bytes')
    sig = b'\x00' + bytes([len(msg)]) + msg
    tx = (struct.pack('<I', 1) + b'\x01' + bytes(32) + b'\xff'*4 + bytes([len(sig)]) + sig + b'\xff'*4 +
          b'\x01' + struct.pack('<Q', 50 * 100000000) + b'\x01\x6a' + bytes(4))
    root = double_sha(tx)
    prefix = struct.pack('<I', 1) + bytes(32) + root + struct.pack('<II', block_time, bits)
    target = compact_target(bits)
    for nonce in range(first, last + 1):
        header = prefix + struct.pack('<I', nonce)
        digest = double_sha(header)
        if int.from_bytes(digest, 'little') <= target:
            return {'time': block_time, 'bits': f'{bits:08x}', 'target': f'{target:064x}', 'nonce': nonce,
                    'transaction': tx.hex(), 'merkle_root': root[::-1].hex(), 'header': header.hex(),
                    'block_hash': digest[::-1].hex(), 'block': (header + b'\x01' + tx).hex()}
    return None


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--message', required=True)
    p.add_argument('--time', required=True, type=int)
    p.add_argument('--bits', required=True, type=lambda s: int(s, 16), help='compact target in hexadecimal')
    p.add_argument('--start-nonce', required=True, type=int)
    p.add_argument('--end-nonce', required=True, type=int)
    a = p.parse_args()
    if not 0 <= a.time <= 0xffffffff or not 0 <= a.bits <= 0xffffffff or not 0 <= a.start_nonce <= a.end_nonce <= 0xffffffff:
        p.error('time, bits and nonce range must fit uint32')
    try:
        result = candidate(a.message, a.time, a.bits, a.start_nonce, a.end_nonce)
    except ValueError as exc:
        p.error(str(exc))
    if result is None:
        print('no valid nonce in the specified range', file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2))
    return 0


if __name__ == '__main__':
    sys.exit(main())
